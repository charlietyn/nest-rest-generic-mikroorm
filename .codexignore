# Files Codex should not read or index.
#
# Kept deliberately in sync with .claudeignore: both agents work on the same
# repo, and a file that is noise for one is noise for the other. This package is
# ~1.7k lines of source; everything below is generated from it, downloaded, or
# a secret.

# --- Dependencies (downloaded, huge, never edited here) ---
node_modules/
.npm/
.pnpm-store/

# --- Build output (generated by `npm run build` from src/) ---
dist/
*.tsbuildinfo

# --- Test and coverage output ---
coverage/
.vitest/
*.lcov

# --- Knowledge-graph output (generated by /graphify; graph.html is large) ---
graphify-out/

# --- Lockfiles (enormous, and npm owns them) ---
package-lock.json
npm-shrinkwrap.json
yarn.lock
pnpm-lock.yaml

# --- Secrets: never send these anywhere ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json

# --- Local databases produced by the integration suite ---
*.sqlite
*.sqlite3
*.db

# --- Logs and OS/editor noise ---
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Agent working directories ---
.claude/
.codex/

# --- Binary / archive formats that are never worth reading as text ---
*.xlsx
*.pdf
*.zip
*.tgz
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.woff
*.woff2
